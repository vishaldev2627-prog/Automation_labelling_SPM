# Copy this file to .env and adjust values for your machine.

# Dataset location (folder containing images/ and labels/ subfolders)
DATASET_PATH=../dataset
EXPORTS_PATH=../exports
MODELS_PATH=../models

# SAM2
SAM_CHECKPOINT=../models/sam2.1_hiera_large.pt
SAM_MODEL_CFG=configs/sam2.1/sam2.1_hiera_l.yaml
SAM_DEVICE=auto
SAM_USE_ONNX=false
SAM_ONNX_ENCODER_PATH=../models/sam2_encoder.onnx
SAM_ONNX_DECODER_PATH=../models/sam2_decoder.onnx

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Processing
MAX_IMAGE_DIMENSION=4096
THUMBNAIL_MAX_DIMENSION=1024
POLYGON_EPSILON_RATIO=0.002
MIN_POLYGON_POINTS=3
MASK_CONFIDENCE_THRESHOLD=0.5
BATCH_MAX_WORKERS=2

# Classes the pipeline never serves, so labels for them are never shippable.
# `leakage` is all-synthetic (pipeline.md §12 / FINAL_AIML_ARCHITECTURE §10:
# `exclude_classes: [leakage]`). Enforced at the tool level: add_class refuses
# these names, and export drops any that already exist in a dataset.
# NOTE: this value is part of every class-map version's hashed content, so
# changing it mints a new class-map version rather than silently altering what
# previous dataset snapshots meant. Comma-separated.
EXCLUDE_CLASSES=leakage

# Margin added around a component bbox when cutting the crops the
# p1_side_damage condition classifier trains on. 7.5% matches the pipeline's
# own P1 crop margin (homography.crop_margin_pct) so training crops are cut the
# same way the serving path cuts them.
CONDITION_CROP_MARGIN_PCT=7.5

# Object store for publishing dataset snapshots (M2 / build plan Phase 5 Q-C:
# this module stages snapshots, the pipeline team imports them into their own
# MLflow - we never write it). Publishing is opt-in per export and can never
# fail an export: the local content-addressed snapshot is the source of truth.
# Defaults below match the automation-minio-1 service in docker-compose.yml.
# Leave S3_ENDPOINT_URL blank to disable publishing entirely.
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=annotator
S3_SECRET_KEY=change-me-8plus
S3_BUCKET=vb-dataset-snapshots
S3_PREFIX=snapshots
S3_REGION=us-east-1

# Similarity-based annotation propagation (Phase 1)
PROPAGATION_ENABLED=true
SIMILARITY_THRESHOLD=0.85
PROPAGATION_TOP_K=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=../logs/backend.log

# Postgres (annotation state, audit history, class-map - see app/db.py).
# For local dev without docker-compose, point POSTGRES_HOST at wherever you're
# running Postgres yourself (e.g. localhost).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=annotator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=annotator
