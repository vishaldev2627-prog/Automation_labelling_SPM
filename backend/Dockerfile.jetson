# Jetson Orin Nano — JetPack 5.1.3 (L4T R35.4.1), CUDA 11.4, Ampere (sm_87)
# dustynv/pytorch ships PyTorch 2.1.0a0+41361538.nv23.06 (a June-2023 nightly
# from NVIDIA — NOT the final torch 2.1.0 release). Key difference: this build
# lacks torch._custom_ops and torch.library.register_fake, which were added in
# the final 2.1.0. Torchvision 0.16+ requires those APIs and fails on import.
# We therefore pin torchvision to 0.15.2 (the last torch-2.0.x-era release),
# which does NOT use those APIs. The C++ ops in 0.15.2 have an ABI mismatch
# with this nightly (so torchvision.ops.nms fails at runtime), but ultralytics
# falls back to pure-torch NMS and the rest of the app (SAM2, mobilenet) only
# uses pure-Python torchvision APIs which work fine.
#
# SAM2 declares torch>=2.5.1 but the ops we use are stable in 2.1; we install
# it with --no-deps to skip the version guard.
FROM dustynv/pytorch:2.1-r35.4.1

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip libgl1 libglib2.0-0 git curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend

COPY requirements.txt .
# ultralytics (via requirements.txt) pulls CPU-only torch 2.4.1 + torchvision
# 0.19.1 from PyPI, overwriting the CUDA dustynv wheel. After install we:
#   1. Restore the CUDA torch from dustynv's cached wheel at /opt/
#   2. Downgrade torchvision to 0.15.2 — the last version that doesn't use
#      torch._custom_ops or torch.library.register_fake (absent in this nightly)
RUN pip3 install --no-cache-dir -r requirements.txt && \
    pip3 install --no-cache-dir --force-reinstall --no-deps \
        /opt/torch-2.1.0a0+41361538.nv23.06-cp38-cp38-linux_aarch64.whl && \
    pip3 install --no-cache-dir --force-reinstall --no-deps \
        "torchvision==0.15.2"

# Clone SAM2 and apply the same aarch64 torch.jit.script() patch as the DGX
# Dockerfile — on Jetson this patch is equally necessary (same aarch64 codegen
# bug in TorchScript). Install with --no-deps to skip the torch>=2.5.1 guard.
RUN git clone --depth 1 https://github.com/facebookresearch/sam2.git /app/sam2 && \
    python3 -c "\
import pathlib; p = pathlib.Path('/app/sam2/sam2/utils/transforms.py'); s = p.read_text(); \
old = 'torch.jit.script(\n            nn.Sequential(\n                Resize((self.resolution, self.resolution)),\n                Normalize(self.mean, self.std),\n            )\n        )'; \
new = 'nn.Sequential(\n            Resize((self.resolution, self.resolution)),\n            Normalize(self.mean, self.std),\n        )'; \
assert old in s, 'patch pattern not found'; p.write_text(s.replace(old, new))" && \
    pip3 install --no-cache-dir --no-build-isolation --no-deps --ignore-requires-python -e /app/sam2

# Verify the CUDA torch and compatible torchvision are in place
RUN python3 -c "import torch, torchvision, warnings; warnings.filterwarnings('ignore'); assert torch.cuda.is_available(), 'CUDA not available after torch restore'; print('Build check OK: torch', torch.__version__, '/ CUDA', torch.version.cuda, '/ torchvision', torchvision.__version__)"

# Pre-download MobileNetV3 weights into the image layer so the first request
# is fast. The /data volume mounts over this on first run (weights persist
# across deploys), but having them baked in means a cold container still works.
RUN python3 -c "import warnings; warnings.filterwarnings('ignore'); import torchvision.models as m; m.mobilenet_v3_small(weights=m.MobileNet_V3_Small_Weights.IMAGENET1K_V1); print('MobileNetV3 weights pre-loaded')"

COPY . .
RUN chmod +x entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["./entrypoint.sh"]
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
