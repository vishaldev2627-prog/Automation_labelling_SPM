# Jetson AGX Orin — JetPack 5.1.3 (L4T R35.4.1), CUDA 11.4, Ampere (sm_87)
# dustynv/pytorch is the community-maintained Jetson PyTorch image (by Dustin
# Franklin, NVIDIA engineer) — the nvcr.io/nvidia/l4t-pytorch series was
# deprecated. Ships PyTorch 2.1.0 + torchvision pre-built for this JetPack.
# SAM2 declares torch>=2.5.1 but the ops we use are stable in 2.1; we install
# it with --no-deps to skip the version guard.
FROM dustynv/pytorch:2.1-r35.4.1

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip libgl1 libglib2.0-0 git curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend

COPY requirements.txt .
# The dustynv base already has CUDA-enabled PyTorch 2.1.0 + torchvision 0.16.x
# built for this JetPack. Pinning them as constraints prevents pip from
# overwriting them with CPU-only PyPI wheels when resolving ultralytics' deps.
RUN printf 'torch<=2.1.0\ntorchvision<=0.16.2\n' > /tmp/jetson_pin.txt && \
    pip3 install --no-cache-dir -r requirements.txt -c /tmp/jetson_pin.txt

# Clone SAM2 and apply the same aarch64 torch.jit.script() patch as the DGX
# Dockerfile — on Jetson this patch is equally necessary (same aarch64 codegen
# bug in TorchScript). Install with --no-deps to skip the torch>=2.5.1 guard.
RUN git clone --depth 1 https://github.com/facebookresearch/sam2.git /app/sam2 && \
    python3 -c "\
import pathlib; p = pathlib.Path('/app/sam2/sam2/utils/transforms.py'); s = p.read_text(); \
old = 'torch.jit.script(\n            nn.Sequential(\n                Resize((self.resolution, self.resolution)),\n                Normalize(self.mean, self.std),\n            )\n        )'; \
new = 'nn.Sequential(\n            Resize((self.resolution, self.resolution)),\n            Normalize(self.mean, self.std),\n        )'; \
assert old in s, 'patch pattern not found'; p.write_text(s.replace(old, new))" && \
    pip3 install --no-cache-dir --no-build-isolation --no-deps --ignore-requires-python -e /app/sam2

RUN python3 -c "import torchvision; torchvision.models.mobilenet_v3_small(weights=torchvision.models.MobileNet_V3_Small_Weights.IMAGENET1K_V1)"

COPY . .
RUN chmod +x entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["./entrypoint.sh"]
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
