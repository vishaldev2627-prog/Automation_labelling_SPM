# Loaded into the backend container by docker-compose.yml (env_file: .env).
# Add optional backend overrides below if you need them (see
# backend/.env.example for the full list) — e.g. CORS_ORIGINS, SAM_DEVICE,
# LOG_LEVEL.
#
# NOTE: the dataset/exports/models host paths are hardcoded directly in
# docker-compose.yml's volumes (not env-var driven) — Coolify does not feed
# its UI-configured env vars into compose's variable-substitution pass, only
# into the running container, so ${VAR}-style bind mount paths silently fall
# back to their defaults under Coolify. Edit docker-compose.yml directly if
# these paths ever need to change.

# HTTP Basic Auth for the review-dashboard service (team-shared credentials).
# If either is left unset, the dashboard runs with no auth at all — only do
# that for local/private-network use.
#
# This .env file only feeds review-dashboard's env_file locally. In Coolify,
# set these directly in that service's own Environment Variables tab instead —
# see the docker-compose.yml comment on review-dashboard for why.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Postgres, shared by the db and backend services above (see docker-compose.yml
# comments on both for why these aren't ${VAR}-interpolated in the compose file
# itself). Local dev only - set matching values directly on both services'
# Coolify Environment Variables tabs in prod, not here.
POSTGRES_USER=annotator
POSTGRES_PASSWORD=change-me
POSTGRES_DB=annotator
